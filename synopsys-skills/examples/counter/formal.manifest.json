{
  "design": "counter",
  "top": "counter",
  "rtl": [
    "${BUNDLE_ROOT}/examples/counter/rtl/counter.sv"
  ],
  "sdc": "${BUNDLE_ROOT}/examples/counter/constraints.sdc",
  "config_tcl": "${BUNDLE_ROOT}/examples/counter/formal-design.tcl",
  "requirements": {
    "clock_period_ns": 10
  },
  "tools": {
    "fm": {
      "executable": "fm_shell",
      "startup_args": [
        "-no_init"
      ],
      "script_option": "-file"
    }
  },
  "stages": [
    {
      "id": "formal",
      "tool": "fm",
      "script": "${BUNDLE_ROOT}/templates/formality.tcl",
      "timeout_s": 90
    }
  ],
  "max_attempts": 1,
  "inputs": [
    "${BUNDLE_ROOT}/examples/counter/design.tcl",
    "${TARGET_DB}",
    "${IMPLEMENTATION_NETLIST}",
    "${SYNTHESIS_SVF}"
  ]
}
