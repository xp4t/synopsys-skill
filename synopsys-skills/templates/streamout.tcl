source $::env(SNPS_FRAMEWORK_ROOT)/templates/common.tcl
snps_main {
    source [snps_required restore_block_recipe]
    foreach name {layer_map cell_gds} { snps_required $name }
    write_gds -layer_map $layer_map -merge_files $cell_gds outputs/final.gds
    # Review stream log, top-cell names, missing cells/layers and merged physical
    # views. Re-run qualified physical verification on the final stream.
    # No automatic pass/result.json: generated bytes alone are not signoff.
}
